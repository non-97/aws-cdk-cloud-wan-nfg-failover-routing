    },
    "InspectionVpcNfwRuleGroup57E7C302": {
      "Properties": {
        "Capacity": 100,
        "RuleGroup": {
          "RulesSource": {
            "RulesString": "pass icmp any any -> any any (alert; sid:2000001; rev:1; msg:"INSPECTED at us-east-1 - ICMP";)
pass tls any any -> any any (ssl_state:client_hello; flow:to_server,established; alert; sid:2000002; rev:1; msg:"INSPECTED at us-east-1 - TLS";)
pass tcp any any -> any any (flow:not_established; sid:3000001; rev:1;)
pass tcp any any -> any any (flow:established; sid:3000002; rev:1;)
pass udp any any -> any any (sid:3000003; rev:1;)
",
          },
          "StatefulRuleOptions": {
            "RuleOrder": "STRICT_ORDER",
          },
        },
        "RuleGroupName": "ReginVpcEF08AF04-Rg",
        "Type": "STATEFUL",
      },
      "Type": "AWS::NetworkFirewall::RuleGroup",
    },
